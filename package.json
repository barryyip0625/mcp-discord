{
  "name": "mcp-discord",
  "version": "1.5.1",
  "description": "Model Context Protocol (MCP) server for Discord integration, allowing Claude and other MCP clients to interact with Discord",
  "main": "build/index.js",
  "bin": {
    "mcp-discord": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "test": "jest --runInBand",
    "build": "tsc",
    "start": "node build/index.js",
    "start-app": "node build/app.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "dev-app": "node --loader ts-node/esm src/app.ts",
    "test-api": "node test-api.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "claude",
    "ai",
    "chatbot",
    "automation"
  ],
  "author": "Barry Yip <barry99625@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barryyip0625/mcp-discord.git"
  },
  "bugs": {
    "url": "https://github.com/barryyip0625/mcp-discord/issues"
  },
  "homepage": "https://github.com/barryyip0625/mcp-discord#readme",
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.50",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "discord.js": "^14.26.5",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "zod": "^3.25.13"
  },
  "overrides": {
    "undici": "6.28.1",
    "fast-uri": "3.1.7",
    "@hono/node-server": "1.19.17",
    "hono": "4.12.34",
    "qs": "6.16.0",
    "ip-address": "10.7.0",
    "browserslist": "4.28.9",
    "js-yaml": "3.15.2",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4"
  }
}
